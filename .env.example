# ========== 服务 ==========
NODE_ENV=development
PORT=3000
# 对外访问的支付中心地址（用于拼接渠道异步回调地址）
PAY_BASE_URL=https://pay.example.com
# 管理后台/开放接口是否开启限流
RATE_LIMIT_ENABLED=true

# ========== 数据库 ==========
DATABASE_URL="mysql://root:password@localhost:3306/pay_center?connection_limit=20&pool_timeout=30"

# ========== Redis（可选：不配置则降级为 MySQL 轮询模式）==========
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ========== 安全 ==========
# 敏感字段（商户私钥、AppSecret）加密存储用的主密钥，32 字节，务必更换！
MASTER_KEY=please_change_this_to_a_random_32_bytes_key
# 回调通知签名密钥（salt），更换后历史签名失效
NOTIFY_SIGN_SALT=

# ========== 默认渠道（initial：sandbox=沙箱/Mock，prod=真实渠道）==========
DEFAULT_CHANNEL_MODE=sandbox

# 微信支付 V3
WECHAT_APPID=
WECHAT_MCH_ID=
WECHAT_SERIAL_NO=
WECHAT_API_V3_KEY=
WECHAT_PRIVATE_KEY_PATH=./certs/wechat/apiclient_key.pem
WECHAT_CERT_PATH=./certs/wechat/apiclient_cert.pem
WECHAT_PLATFORM_CERT_PATH=./certs/wechat/wechatpay_platform_cert.pem

# 支付宝
ALIPAY_APPID=
ALIPAY_PRIVATE_KEY_PATH=./certs/alipay/app_private_key.pem
ALIPAY_PUBLIC_KEY_PATH=./certs/alipay/alipay_public_key.pem
ALIPAY_SIGN_TYPE=RSA2
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

# ========== 通知 ==========
NOTIFY_MAX_RETRY=8
NOTIFY_TIMEOUT_MS=5000
# 重试退避阶梯（秒）：1,5,30,300,1800,3600,7200,21600
NOTIFY_BACKOFF=1,5,30,300,1800,3600,7200,21600
# 通知失败达到最大次数后的告警接收（多个用逗号分隔）
ALERT_EMAILS=

# ========== 对账 ==========
# 每日自动对账的 cron（默认每天 06:30 对前一日）
RECONCILE_CRON=30 6 * * *
# 自动拉取渠道账单的 cron（默认每天 07:00 拉前一日）
BILL_FETCH_CRON=0 7 * * *
# 对账差异告警阈值：差异笔数超过该值触发告警
RECONCILE_DIFF_ALERT_THRESHOLD=10
# 账单文件存放目录
BILL_STORE_DIR=./storage/bills
